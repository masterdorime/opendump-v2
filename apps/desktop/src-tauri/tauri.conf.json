{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opendump",
  "version": "0.1.0",
  "identifier": "io.github.masterdorime.opendump",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "opendump",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#080b10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
